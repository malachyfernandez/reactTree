{
  "name": "react-jsx-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "react-jsx-tree": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --platform node --target node18 --no-dts --sourcemap",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@babel/parser": "^7.27.0",
    "@babel/traverse": "^7.27.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chokidar": "^4.0.3",
    "picocolors": "^1.1.0",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/yargs": "^17.0.33",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
